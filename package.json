{
  "name": "workeros",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @workeros/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @workeros/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @workeros/db generate",
    "db:migrate": "pnpm --filter @workeros/db migrate",
    "db:seed": "pnpm --filter @workeros/db seed",
    "mcp:dev": "pnpm --filter @workeros/enterprise-mcp dev",
    "mcp:cloud": "bash scripts/start-cloud-mcp.sh",
    "day-one:dev": "bash scripts/start-day-one.sh",
    "adk:dev": "cd services/adk-agents && .venv/bin/python -m uvicorn app:app --reload --port 8001"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
