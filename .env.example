# Use 127.0.0.1 after starting the Cloud SQL Auth Proxy; never commit a real password.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/workeros
MCP_PORT=4000
GOOGLE_CLOUD_PROJECT=workeros-demo-20260825
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
WORKEROS_GEMINI_MODEL=gemini-3.5-flash
TRUEFORGE_BASE_URL=https://YOUR-TRUEFORGE-HOST
TRUEFORGE_TOKEN=replace-with-tenant-token
TRUEFORGE_AGENT_NAME=revenue-integrity-supervisor
